{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "name": { "type": "string", "description": "The user's display name." },
        "email": { "type": "string", "description": "The user's email address." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "The user's role." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Stores product details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique identifier for the product." },
        "name": { "type": "string", "description": "The product's name." },
        "description": { "type": "string", "description": "The product's description." },
        "price": { "type": "number", "description": "The product's price." },
        "stock": { "type": "number", "description": "The product's stock quantity." },
        "category": { "type": "string", "description": "The product's category." },
        "images": { "type": "array", "items": { "type": "string" }, "description": "The product's image URLs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the product was added." }
      },
      "required": ["name", "price", "stock", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Stores order information.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique identifier for the order." },
        "userId": { "type": "string", "description": "The ID of the user who placed the order." },
        "items": { "type": "array", "items": { "type": "object" }, "description": "The items ordered." },
        "total": { "type": "number", "description": "The total price of the order." },
        "status": { "type": "string", "enum": ["pending", "shipped", "delivered"], "description": "The order's status." },
        "address": { "type": "object", "description": "The shipping address." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the order was placed." }
      },
      "required": ["userId", "items", "total", "status", "address"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products in the shop."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    }
  }
}
